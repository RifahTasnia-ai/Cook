  <script>
    const strip = document.getElementById('tapped-day-strip');
    const cells = document.querySelectorAll('#heatmap-grid [data-day]');
    cells.forEach((cell) => {
      cell.addEventListener('click', () => {
        cells.forEach((c) => c.classList.remove('ring-2', 'ring-primary'));
        cell.classList.add('ring-2', 'ring-primary');
        strip.textContent = cell.dataset.day;
      });
    });

    const tf90 = document.getElementById('tf-90d');
    const tf1y = document.getElementById('tf-1y');
    const counts = document.getElementById('activity-counts');
    tf90.addEventListener('click', () => {
      tf90.classList.add('bg-primary', 'text-on-primary');
      tf90.classList.remove('text-on-surface-variant');
      tf1y.classList.remove('bg-primary', 'text-on-primary');
      tf1y.classList.add('text-on-surface-variant');
      counts.textContent = '42 Active • 18 Red';
    });
    tf1y.addEventListener('click', () => {
      tf1y.classList.add('bg-primary', 'text-on-primary');
      tf1y.classList.remove('text-on-surface-variant');
      tf90.classList.remove('bg-primary', 'text-on-primary');
      tf90.classList.add('text-on-surface-variant');
      counts.textContent = '214 Active • 78 Red';
    });
  </script>


